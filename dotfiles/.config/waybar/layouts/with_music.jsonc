{
    "layer" : "top",
    "position" : "top",
    "width" : 1920,
    "margin" : "5 0",
    "reload_style_on_change": true,

    "group/gbattery" : {
        "orientation": "horizontal",
        "modules" : [
            "battery"
        ]
    },

    "group/gworkspaces" : {
        "orientation": "horizontal",
        "modules" : [
            "hyprland/workspaces"
        ]
    },

    "group/gsystem" : {
        "orientation": "horizontal",
        "modules" : [
            "backlight", "wireplumber", "bluetooth", "network", "memory", "cpu", "temperature"
            
        ]
    },

    "modules-left"   : ["power-profiles-daemon", "group/gbattery", "group/gworkspaces", "mpris"],
    "modules-center" : ["clock"],
    "modules-right"  : ["group/gsystem", "tray", "custom/ctlcenter"],

    "include": [ "~/.config/waybar/modules.jsonc" ]
}

